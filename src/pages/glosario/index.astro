---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const entries = await getCollection('glosario');
const sorted = entries.sort((a, b) => a.data.term.localeCompare(b.data.term, 'es'));

const siteUrl = 'https://eslahoradeaprender.com';
const canonical = `${siteUrl}/glosario/`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Glosario', item: canonical },
  ],
};

const definedTermSetLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glosario de Es la Hora de Aprender',
  description: 'Términos técnicos de IA, agentes y automatización que aparecen recurrentemente en el podcast.',
  url: canonical,
  inLanguage: 'es',
  hasDefinedTerm: sorted.map((e) => ({
    '@type': 'DefinedTerm',
    name: e.data.term,
    description: e.data.description,
    url: `${siteUrl}/glosario/${e.id}/`,
  })),
};

const escapeJsonLd = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Glosario"
  description="Glosario de términos técnicos de IA, agentes y automatización que aparecen en el podcast. Definiciones cortas y links a los episodios donde se desarmaron."
  seoTitle="Glosario de IA, agentes y automatización | Es la Hora de Aprender"
  seoDescription="Glosario de términos técnicos de IA que aparecen en el podcast: MCP, tool use, agente, MoE, RAG, computer use, vibecoding y más. Con links a los episodios donde se explicaron."
  ogType="website"
  canonicalUrl={canonical}
>
    <Fragment slot="head-extra">
        <script is:inline type="application/ld+json" set:html={escapeJsonLd(breadcrumbLd)} />
        {sorted.length > 0 && (
            <script is:inline type="application/ld+json" set:html={escapeJsonLd(definedTermSetLd)} />
        )}
    </Fragment>

    <SiteHeader />

    <main id="main-content" class="max-w-5xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="mb-6 md:mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 flex-wrap border-[3px] border-black bg-white px-3 py-2 text-xs md:text-sm font-black uppercase tracking-wider">
                <li><a href="/" class="bg-black text-acid px-2 py-1 hover:bg-electric hover:text-white transition-colors">Inicio</a></li>
                <li class="text-black font-black" aria-hidden="true">/</li>
                <li class="text-gray-600" aria-current="page">Glosario</li>
            </ol>
        </nav>

        <header class="mb-10 md:mb-14">
            <h1 class="text-3xl md:text-5xl font-black mb-4 leading-tight tracking-tighter text-black">
                Glosario
            </h1>
            <p class="text-gray-700 text-base md:text-lg leading-relaxed max-w-3xl">
                Términos técnicos de IA, agentes y automatización que vuelven en cada episodio. Definiciones cortas, cero jerga inútil, con enlaces a los episodios y guías donde los desarmamos.
            </p>
        </header>

        {sorted.length === 0 && (
            <p class="text-gray-700">Próximamente.</p>
        )}

        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5 list-none p-0">
            {sorted.map((e) => (
                <li>
                    <a href={`/glosario/${e.id}/`} class="brutal-card p-5 md:p-6 bg-white hover:bg-acid transition-colors block h-full">
                        <h2 class="text-lg md:text-xl font-black tracking-tighter leading-tight mb-2 text-black">
                            {e.data.term}
                        </h2>
                        {e.data.aliases && e.data.aliases.length > 0 && (
                            <p class="text-xs font-bold text-gray-600 mb-2">
                                ↳ {e.data.aliases.join(' · ')}
                            </p>
                        )}
                        <p class="text-sm leading-relaxed text-gray-700">
                            {e.data.description}
                        </p>
                    </a>
                </li>
            ))}
        </ul>
    </main>

    <SiteFooter />
</BaseLayout>
