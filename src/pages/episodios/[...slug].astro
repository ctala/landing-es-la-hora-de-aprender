---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SocialShare from '../../components/SocialShare.astro';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  const sorted = [...episodes].sort((a, b) => a.data.episode - b.data.episode);
  const byEpNumber = new Map(episodes.map(e => [e.data.episode, e]));

  return episodes.map(ep => {
    const idx = sorted.findIndex(e => e.id === ep.id);
    const related = (ep.data.relatedEpisodes ?? []).map(num => {
      const found = byEpNumber.get(num);
      if (!found) {
        throw new Error(
          `Episodio ${ep.data.episode} ("${ep.id}") referencia relatedEpisodes: ${num}, pero ningún episodio con ese número existe en la colección. Corrige el frontmatter.`
        );
      }
      if (num === ep.data.episode) {
        throw new Error(
          `Episodio ${ep.data.episode} ("${ep.id}") se referencia a sí mismo en relatedEpisodes. Quítalo del frontmatter.`
        );
      }
      return found;
    });

    return {
      params: { slug: ep.id },
      props: {
        ep,
        prev: sorted[idx - 1] ?? null,
        next: sorted[idx + 1] ?? null,
        related,
      },
    };
  });
}

const { ep: episodeData, prev: prevEpisode, next: nextEpisode, related: relatedEpisodes } = Astro.props;
const episode = episodeData.id;
const { Content, headings } = await render(episodeData);
const h2Headings = headings.filter((h) => h.depth === 2);
const TOPICS_VISIBLE = 5;

const siteUrl = 'https://eslahoradeaprender.com';
const canonical = `${siteUrl}/episodios/${episode}/`;
const thumbAbs = episodeData.data.thumbnail
  ? `${siteUrl}${episodeData.data.thumbnail}`
  : `https://img.youtube.com/vi/${episodeData.data.youtubeId}/maxresdefault.jpg`;

function toISODuration(totalSec: number): string {
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  return `PT${h ? `${h}H` : ''}${m}M${s}S`;
}
const isoDuration = toISODuration(episodeData.data.durationSeconds);

const { timestamps, resources, faq, guests, updatedAt, keyTakeaways } = episodeData.data;

const authorList = episodeData.data.hosts.map(h => ({
  '@type': 'Person',
  name: h.name,
  url: h.linkedin,
}));

const guestList = (guests ?? []).map(g => ({
  '@type': 'Person',
  name: g.name,
  ...(g.role && { jobTitle: g.role }),
  ...(g.company && { affiliation: { '@type': 'Organization', name: g.company } }),
  ...(g.linkedin && { url: g.linkedin }),
  ...(g.bio && { description: g.bio }),
}));

const podcastEpisodeLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  url: canonical,
  name: episodeData.data.title,
  description: episodeData.data.seoDescription ?? episodeData.data.description,
  datePublished: episodeData.data.date,
  ...(updatedAt && { dateModified: updatedAt }),
  duration: isoDuration,
  episodeNumber: episodeData.data.episode,
  inLanguage: 'es',
  image: thumbAbs,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.shownotes p:first-of-type', '.shownotes h2 + ul'],
  },
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'Es la Hora de Aprender',
    url: siteUrl,
  },
  partOfSeason: {
    '@type': 'PodcastSeason',
    seasonNumber: episodeData.data.season,
  },
  associatedMedia: {
    '@type': 'MediaObject',
    contentUrl: episodeData.data.youtube,
  },
  author: authorList,
  ...(guestList.length > 0 && { actor: guestList }),
  ...(keyTakeaways && keyTakeaways.length > 0 && {
    about: keyTakeaways.map(t => ({ '@type': 'Thing', name: t })),
  }),
  ...(resources && resources.length > 0 && {
    citation: resources.map(r => ({
      '@type': 'CreativeWork',
      name: r.title,
      url: r.url,
      ...(r.description && { description: r.description }),
    })),
  }),
};

const videoObjectLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: episodeData.data.title,
  description: episodeData.data.seoDescription ?? episodeData.data.description,
  thumbnailUrl: thumbAbs,
  uploadDate: episodeData.data.date,
  ...(updatedAt && { dateModified: updatedAt }),
  duration: isoDuration,
  contentUrl: episodeData.data.youtube,
  embedUrl: `https://www.youtube.com/embed/${episodeData.data.youtubeId}`,
  publisher: {
    '@type': 'Organization',
    name: 'Es la Hora de Aprender',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/og-image.jpg`,
    },
  },
  ...(timestamps && timestamps.length > 0 && {
    hasPart: timestamps.map(t => ({
      '@type': 'Clip',
      name: t.label,
      startOffset: t.seconds,
      url: `${episodeData.data.youtube}&t=${t.seconds}s`,
    })),
  }),
};

const faqPageLd = (faq && faq.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Episodios', item: `${siteUrl}/episodios/` },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Episodio ${episodeData.data.episode}: ${episodeData.data.title}`,
      item: canonical,
    },
  ],
};

const escapeJsonLd = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<BaseLayout
  title={episodeData.data.title}
  description={episodeData.data.description}
  seoTitle={episodeData.data.seoTitle}
  seoDescription={episodeData.data.seoDescription}
  image={episodeData.data.ogImage || thumbAbs}
  ogType="article"
  keywords={episodeData.data.keywords}
  datePublished={episodeData.data.date}
  canonicalUrl={canonical}
>
    <Fragment slot="head-extra">
        <script is:inline type="application/ld+json" set:html={escapeJsonLd(podcastEpisodeLd)} />
        <script is:inline type="application/ld+json" set:html={escapeJsonLd(videoObjectLd)} />
        <script is:inline type="application/ld+json" set:html={escapeJsonLd(breadcrumbLd)} />
        {faqPageLd && (
            <script is:inline type="application/ld+json" set:html={escapeJsonLd(faqPageLd)} />
        )}
    </Fragment>

    <SiteHeader />

    <main id="main-content" class="max-w-6xl mx-auto">

        <!-- Breadcrumb -->
        <nav class="mb-6 md:mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 flex-wrap border-[3px] border-black bg-white px-3 py-2 text-xs md:text-sm font-black uppercase tracking-wider">
                <li><a href="/" class="bg-black text-acid px-2 py-1 hover:bg-electric hover:text-white transition-colors focus-visible:outline-4 focus-visible:outline-electric focus-visible:outline-offset-2">Inicio</a></li>
                <li class="text-black font-black" aria-hidden="true">/</li>
                <li><a href="/episodios/" class="hover:underline underline-offset-4 decoration-4 decoration-black focus-visible:outline-4 focus-visible:outline-electric focus-visible:outline-offset-2">Episodios</a></li>
                <li class="text-black font-black" aria-hidden="true">/</li>
                <li class="text-gray-600 truncate max-w-[180px] md:max-w-[380px]" aria-current="page">EP {episodeData.data.episode}: {episodeData.data.title}</li>
            </ol>
        </nav>

        <article class="brutal-card p-6 md:p-10 episode-card">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
                <!-- Video Thumbnail (click to play) -->
                <div class="lg:col-span-7">
                    <div class="video-embed brutal-card youtube-facade" data-id={episodeData.data.youtubeId}>
                        <img 
                            src={episodeData.data.thumbnail?.replace('.webp', '-sm.webp') || `https://img.youtube.com/vi/${episodeData.data.youtubeId}/maxresdefault.jpg`}
                            alt={`Thumbnail del episodio: ${episodeData.data.title}`}
                            loading="eager"
                            width="648"
                            height="365"
                            style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;cursor:pointer;"
                        />
                        <button class="yt-play-btn" aria-label={`Reproducir ${episodeData.data.title}`}>
                            <svg width="68" height="48" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Info Section -->
                <div class="lg:col-span-5">
                    <div class="mb-4">
                        <span class="bg-black text-acid px-3 py-1 text-xs uppercase font-black tracking-wider">
                            Episodio {episodeData.data.episode}
                        </span>
                        <span class="text-sm text-gray-500 ml-3">{episodeData.data.duration}</span>
                    </div>
                    
                    <h1 class="text-2xl md:text-3xl font-black mb-4 leading-tight tracking-tighter text-black">
                        {episodeData.data.title}
                    </h1>
                    
                    <p class="text-gray-700 text-base md:text-lg mb-5 leading-relaxed">
                        {episodeData.data.description}
                    </p>

                    <div class="mb-5 topics-container" data-total={episodeData.data.topics.length}>
                        <h3 class="text-sm font-black uppercase tracking-wider mb-3 text-gray-700">Temas tratados</h3>
                        <div class="flex flex-wrap gap-2 topics-list">
                            {episodeData.data.topics.map((topic, i) => (
                                <span class={`bg-acid text-black px-3 py-1 text-xs font-bold uppercase border-2 border-black topic-tag ${i >= TOPICS_VISIBLE ? 'hidden' : ''}`} data-index={i}>
                                    {topic}
                                </span>
                            ))}
                        </div>
                        {episodeData.data.topics.length > TOPICS_VISIBLE && (
                            <button class="topics-toggle text-xs font-bold uppercase mt-3 text-electric hover:text-black transition-colors">
                                Ver {episodeData.data.topics.length - TOPICS_VISIBLE} temas más ↓
                            </button>
                        )}
                    </div>

                    <!-- CTAs secundarios: plataformas en fila -->
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <a href={episodeData.data.youtube} target="_blank" rel="noopener noreferrer"
                           class="brutal-btn bg-white hover:bg-red-500 hover:text-white text-sm">
                            <svg width="18" height="13" viewBox="0 0 68 48" fill="currentColor" aria-hidden="true"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path d="M45 24L27 14v20" fill="white"/></svg>
                            YouTube
                        </a>
                        <a href={episodeData.data.spotify} target="_blank" rel="noopener noreferrer"
                           class="brutal-btn bg-electric text-white hover:bg-black text-sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                            Spotify
                        </a>
                    </div>
                </div>
            </div>
        </article>

        <!-- Capítulos clickables (si el frontmatter define timestamps) -->
        {timestamps && timestamps.length > 0 && (
            <section class="chapters brutal-card mt-8 md:mt-10 p-6 md:p-8" aria-labelledby="chapters-heading">
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-4 md:mb-5">
                    <h2 id="chapters-heading" class="text-xl md:text-2xl font-black uppercase tracking-tighter">
                        Capítulos <span class="bg-electric text-white px-2">del episodio</span>
                    </h2>
                    <p class="text-xs text-gray-700 font-bold uppercase tracking-wider">
                        {timestamps.length} saltos · abre en YouTube
                    </p>
                </div>
                <ol class="chapters-list grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-3" role="list">
                    {timestamps.map((t) => (
                        <li>
                            <a
                                href={`${episodeData.data.youtube}&t=${t.seconds}s`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="chapter-link"
                                aria-label={`Saltar al minuto ${t.time} — ${t.label}`}>
                                <span class="chapter-time">{t.time}</span>
                                <span class="chapter-label">{t.label}</span>
                                <span class="chapter-arrow" aria-hidden="true">↗</span>
                            </a>
                        </li>
                    ))}
                </ol>
            </section>
        )}

        <!-- Shownotes + TOC sticky (solo desktop) -->
        <div class="shownotes-layout mt-8 md:mt-10">
            {h2Headings.length > 0 && (
                <aside class="shownotes-toc hidden lg:block" aria-label="Índice del episodio">
                    <h2 class="text-xs font-black uppercase tracking-wider mb-4 text-gray-700">En este episodio</h2>
                    <ol class="toc-list">
                        {h2Headings.map((h) => (
                            <li><a href={`#${h.slug}`}>{h.text}</a></li>
                        ))}
                    </ol>
                </aside>
            )}
            <section class="shownotes brutal-card p-6 md:p-10" aria-label="Contenido del episodio">
                <Content />
            </section>
        </div>

        <!-- Social share -->
        <SocialShare url={canonical} title={episodeData.data.title} />

        <!-- Episodios relacionados (si el frontmatter define relatedEpisodes) -->
        {relatedEpisodes && relatedEpisodes.length > 0 && (
            <section class="related-episodes mt-8 md:mt-10" aria-labelledby="related-heading">
                <h2 id="related-heading" class="text-2xl md:text-3xl font-black uppercase tracking-tighter mb-6">
                    Episodios <span class="bg-acid text-black px-2">relacionados</span>
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
                    {relatedEpisodes.map((rep) => (
                        <article class="brutal-card episode-card-compact group">
                            <a href={`/episodios/${rep.id}/`} class="block">
                                <div class="relative aspect-video overflow-hidden">
                                    <img
                                        src={rep.data.thumbnail?.replace('.webp', '-xs.webp') || `https://img.youtube.com/vi/${rep.data.youtubeId}/mqdefault.jpg`}
                                        srcset={rep.data.thumbnail ? `${rep.data.thumbnail.replace('.webp', '-xs.webp')} 400w, ${rep.data.thumbnail.replace('.webp', '-sm.webp')} 648w` : undefined}
                                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                        alt={`Thumbnail: ${rep.data.title}`}
                                        width="400"
                                        height="225"
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                    <div class="absolute top-3 left-3">
                                        <span class="bg-black text-acid px-2 py-1 text-[10px] uppercase font-black tracking-wider">
                                            EP {rep.data.episode}
                                        </span>
                                    </div>
                                    <div class="absolute bottom-3 right-3">
                                        <span class="bg-black/80 text-white px-2 py-1 text-[10px] font-bold">
                                            {rep.data.duration}
                                        </span>
                                    </div>
                                </div>
                            </a>
                            <div class="p-4 md:p-5">
                                <h3 class="text-base md:text-lg font-black leading-tight tracking-tight text-black line-clamp-2">
                                    <a href={`/episodios/${rep.id}/`} class="hover:text-electric transition-colors">
                                        {rep.data.title}
                                    </a>
                                </h3>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        )}

        <!-- Navegación entre episodios -->
        <div class="flex flex-row justify-between items-center mt-8 md:mt-10 gap-4">
            {prevEpisode ? (
                <a href={`/episodios/${prevEpisode.id}/`} class="brutal-btn bg-white hover:bg-acid text-xs py-2 px-4">
                    ← Episodio {prevEpisode.data.episode}
                </a>
            ) : <span />}
            <a href="/" class="text-xs font-bold uppercase tracking-wider text-gray-500 hover:text-black transition-colors">
                Ver todos →
            </a>
            {nextEpisode ? (
                <a href={`/episodios/${nextEpisode.id}/`} class="brutal-btn bg-white hover:bg-acid text-xs py-2 px-4">
                    Episodio {nextEpisode.data.episode} →
                </a>
            ) : <span />}
        </div>

    </main>

    <SiteFooter />

    <style>
        /* Topics toggle */
        .topic-tag.hidden {
            display: none;
        }
        .topics-container.expanded .topic-tag.hidden {
            display: inline-block;
        }

        /* Related episodes cards (reutiliza patrón de /episodios/index.astro) */
        .episode-card-compact {
            background: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .episode-card-compact:hover {
            transform: translateY(-4px);
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Shownotes: prose styles scoped al contenido renderizado */
        .shownotes {
            background: #fff;
        }
        .shownotes > :global(*) {
            max-width: 70ch;
            margin-left: auto;
            margin-right: auto;
        }
        .shownotes :global(:first-child) {
            margin-top: 0;
        }
        .shownotes :global(p),
        .shownotes :global(ul),
        .shownotes :global(ol),
        .shownotes :global(table),
        .shownotes :global(blockquote),
        .shownotes :global(pre) {
            font-size: 1.0625rem;
            line-height: 1.7;
            color: #1a1a1a;
            margin: 1em 0;
        }
        .shownotes :global(h2) {
            font-family: 'Archivo Black', sans-serif;
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: -0.02em;
            margin: 2em 0 0.6em;
            padding-bottom: 0.3em;
            border-bottom: 3px solid var(--black);
            /* Deja aire arriba cuando se llega por ancla #slug del TOC */
            scroll-margin-top: 2rem;
        }
        .shownotes :global(h3) {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            margin: 1.6em 0 0.5em;
        }
        .shownotes :global(a) {
            color: var(--electric-blue);
            text-decoration: underline;
            text-underline-offset: 3px;
            font-weight: 700;
        }
        .shownotes :global(a:hover) {
            color: var(--black);
            background: var(--acid-green);
        }
        .shownotes :global(strong) { font-weight: 800; }
        .shownotes :global(em) { font-style: italic; }
        .shownotes :global(ul),
        .shownotes :global(ol) {
            padding-left: 1.4em;
        }
        .shownotes :global(li) {
            margin: 0.3em 0;
        }
        .shownotes :global(blockquote) {
            border-left: 4px solid var(--acid-green);
            padding: 0.2em 1em;
            font-style: italic;
            color: #333;
            background: #fafafa;
        }
        .shownotes :global(code) {
            font-family: 'SFMono-Regular', Menlo, monospace;
            background: #f0f0f0;
            padding: 0.1em 0.35em;
            border: 1px solid #e0e0e0;
            font-size: 0.92em;
        }
        .shownotes :global(pre) {
            background: #111;
            color: #f5f5f5;
            padding: 1em;
            overflow-x: auto;
            border: 3px solid var(--black);
        }
        .shownotes :global(pre code) {
            background: transparent;
            border: none;
            color: inherit;
            padding: 0;
        }
        .shownotes :global(table) {
            border-collapse: collapse;
            width: 100%;
            font-size: 0.95rem;
        }
        /* Mobile: tabla como bloque con scroll horizontal si no cabe */
        @media (max-width: 768px) {
            .shownotes :global(table) {
                display: block;
                overflow-x: auto;
                max-width: 100%;
                -webkit-overflow-scrolling: touch;
            }
        }
        .shownotes :global(th),
        .shownotes :global(td) {
            border: 2px solid var(--black);
            padding: 0.55em 0.8em;
            text-align: left;
            vertical-align: top;
        }
        .shownotes :global(th) {
            background: var(--acid-green);
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.03em;
        }
        .shownotes :global(img) {
            max-width: 100%;
            height: auto;
            border: 3px solid var(--black);
        }
        .shownotes :global(hr) {
            border: none;
            border-top: 3px solid var(--black);
            margin: 2.2em 0;
        }

        /* Layout shownotes + TOC sticky (solo ≥lg) */
        .shownotes-layout {
            position: relative;
        }
        @media (min-width: 1024px) {
            .shownotes-layout {
                display: grid;
                grid-template-columns: 240px 1fr;
                gap: 2rem;
                align-items: start;
            }
        }

        /* TOC card (sticky en desktop, oculto en mobile) */
        .shownotes-toc {
            background: white;
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
            padding: 1.25rem 1.25rem 1.25rem 1rem;
            position: sticky;
            top: 1.5rem;
            max-height: calc(100vh - 3rem);
            overflow-y: auto;
        }
        .toc-list {
            list-style: decimal;
            padding-left: 1.25rem;
            margin: 0;
            font-size: 0.8125rem;
            line-height: 1.45;
            color: #1a1a1a;
        }
        .toc-list li {
            margin-bottom: 0.5rem;
        }
        .toc-list a {
            color: #1a1a1a;
            text-decoration: none;
            transition: color 0.1s, background 0.1s;
            padding: 0.1em 0.2em;
        }
        .toc-list a:hover {
            color: var(--electric-blue);
            text-decoration: underline;
            text-underline-offset: 2px;
        }
        .toc-list a.active {
            background: var(--acid-green);
            color: var(--black);
            font-weight: 800;
        }

        /* Capítulos clickables (timestamps -> YouTube con ?t=Xs) */
        .chapters-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .chapter-link {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.85rem;
            border: 2px solid var(--black);
            background: white;
            text-decoration: none;
            color: var(--black);
            font-size: 0.9rem;
            line-height: 1.3;
            transition: all 0.1s;
        }
        .chapter-link:hover {
            background: var(--acid-green);
            transform: translate(-1px, -1px);
            box-shadow: 3px 3px 0px 0px var(--black);
        }
        .chapter-time {
            font-family: 'SFMono-Regular', Menlo, monospace;
            font-weight: 800;
            font-size: 0.8rem;
            background: var(--black);
            color: var(--acid-green);
            padding: 0.15em 0.5em;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }
        .chapter-label {
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .chapter-arrow {
            font-size: 0.85rem;
            color: var(--electric-blue);
            font-weight: 800;
        }
        .chapter-link:hover .chapter-arrow {
            color: var(--black);
        }
    </style>

    <script is:inline>
        // YouTube facade click handler
        document.querySelectorAll('.youtube-facade').forEach(el => {
            el.addEventListener('click', function() {
                const id = this.dataset.id;
                const iframe = document.createElement('iframe');
                iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
                iframe.title = 'YouTube video player';
                iframe.setAttribute('frameborder', '0');
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;';
                this.innerHTML = '';
                this.appendChild(iframe);
            });
        });
        
        // Topics toggle handler
        document.querySelectorAll('.topics-toggle').forEach(btn => {
            btn.addEventListener('click', function() {
                const container = this.closest('.topics-container');
                const isExpanded = container.classList.toggle('expanded');
                const total = parseInt(container.dataset.total);
                const visible = 5;
                this.textContent = isExpanded ? 'Ver menos ↑' : `Ver ${total - visible} temas más ↓`;
            });
        });

        // TOC active-section highlight (solo si el TOC existe y es visible)
        (function () {
            const tocLinks = document.querySelectorAll('.shownotes-toc .toc-list a');
            if (tocLinks.length === 0 || !('IntersectionObserver' in window)) return;

            const linkBySlug = new Map();
            tocLinks.forEach((a) => {
                const hash = a.getAttribute('href') || '';
                if (hash.startsWith('#')) linkBySlug.set(hash.slice(1), a);
            });

            const h2Nodes = document.querySelectorAll('.shownotes h2[id]');
            if (h2Nodes.length === 0) return;

            let currentActive = null;
            const setActive = (slug) => {
                if (currentActive === slug) return;
                tocLinks.forEach((a) => a.classList.remove('active'));
                const link = linkBySlug.get(slug);
                if (link) link.classList.add('active');
                currentActive = slug;
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    // Priorizamos el H2 más cercano a la zona superior del viewport
                    const visible = entries
                        .filter((e) => e.isIntersecting)
                        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
                    if (visible.length > 0) {
                        setActive(visible[0].target.id);
                    }
                },
                {
                    rootMargin: '-20% 0px -70% 0px',
                    threshold: 0,
                }
            );
            h2Nodes.forEach((h) => observer.observe(h));
        })();
    </script>
</BaseLayout>
