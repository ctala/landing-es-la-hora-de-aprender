---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
    const episodes = await getCollection('episodes');
    // Sort by episode number for prev/next navigation
    const sorted = episodes.sort((a, b) => a.data.episode - b.data.episode);
    
    return sorted.map((ep, index) => ({
        params: { slug: ep.id },
        props: { 
            episode: ep.data,
            slug: ep.id,
            prev: index > 0 ? sorted[index - 1] : null,
            next: index < sorted.length - 1 ? sorted[index + 1] : null,
        },
    }));
}

const { episode, slug, prev, next } = Astro.props;
const episodeUrl = `https://eslahoradeaprender.com/episodios/${slug}`;
const ogImage = episode.ogImage || `https://img.youtube.com/vi/${episode.youtubeId}/maxresdefault.jpg`;
const embedUrl = `https://www.youtube.com/embed/${episode.youtubeId}`;
---

<BaseLayout 
    title={episode.seoTitle || episode.title} 
    description={episode.seoDescription || episode.description}
    image={ogImage}
    ogType="article"
    keywords={episode.keywords || episode.topics}
    canonicalUrl={episodeUrl}
    datePublished={`${episode.date}T00:00:00-03:00`}
>
    <SiteHeader />

    <!-- Breadcrumbs -->
    <nav class="max-w-6xl mx-auto mb-6 text-sm">
        <ol class="flex items-center gap-2 text-gray-600">
            <li><a href="/" class="hover:text-electric font-bold">Inicio</a></li>
            <li>/</li>
            <li><a href="/#episodios" class="hover:text-electric font-bold">Episodios</a></li>
            <li>/</li>
            <li class="text-gray-900 font-black">Episodio {episode.episode}</li>
        </ol>
    </nav>

    <!-- Episode Header -->
    <article class="max-w-6xl mx-auto mb-12">
        <div class="brutal-card bg-white p-6 md:p-10">
            <!-- Meta -->
            <div class="flex items-center gap-4 mb-6">
                <span class="bg-black text-acid px-4 py-2 text-sm uppercase font-black tracking-wider">
                    Episodio {episode.episode}
                </span>
                <span class="text-gray-500 font-bold">{episode.duration}</span>
                <span class="text-gray-500">•</span>
                <time datetime={episode.date} class="text-gray-500 font-bold">
                    {new Date(episode.date + 'T12:00:00').toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
            </div>

            <!-- Title -->
            <h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight tracking-tighter text-black">
                {episode.title}
            </h1>

            <!-- Description -->
            <p class="text-lg md:text-xl text-gray-700 mb-8 leading-relaxed border-l-4 border-electric pl-6">
                {episode.description}
            </p>

            <!-- Hosts -->
            <div class="mb-8">
                <h3 class="text-sm uppercase tracking-wider font-black text-gray-500 mb-3">Con:</h3>
                <div class="flex flex-wrap gap-3">
                    {episode.hosts.map(host => (
                        <a href={host.linkedin} target="_blank" rel="noopener noreferrer"
                           class="name-tag hover:bg-electric transition-colors">
                            {host.name}
                        </a>
                    ))}
                </div>
            </div>

            <!-- Topics -->
            <div class="mb-8">
                <h3 class="text-sm uppercase tracking-wider font-black text-gray-500 mb-3">Temas:</h3>
                <div class="flex flex-wrap gap-2">
                    {episode.topics.map(topic => (
                        <span class="bg-acid text-black px-3 py-1 text-xs font-bold uppercase border-2 border-black">
                            {topic}
                        </span>
                    ))}
                </div>
            </div>

            <!-- Share Buttons -->
            <div class="flex flex-wrap gap-3 pt-6 border-t-2 border-black">
                <span class="text-sm font-black uppercase text-gray-500 mr-2">Compartir:</span>
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(episode.title)}&url=${encodeURIComponent(episodeUrl)}`}
                   target="_blank" rel="noopener noreferrer"
                   class="brutal-btn bg-white hover:bg-black hover:text-white text-xs py-2 px-4">
                    Twitter
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(episodeUrl)}`}
                   target="_blank" rel="noopener noreferrer"
                   class="brutal-btn bg-white hover:bg-electric hover:text-white text-xs py-2 px-4">
                    LinkedIn
                </a>
                <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(episodeUrl)}`}
                   target="_blank" rel="noopener noreferrer"
                   class="brutal-btn bg-white hover:bg-blue-600 hover:text-white text-xs py-2 px-4">
                    Facebook
                </a>
                <button onclick="navigator.clipboard.writeText(window.location.href); alert('¡Link copiado!')"
                        class="brutal-btn bg-acid text-xs py-2 px-4">
                    Copiar Link
                </button>
            </div>
        </div>
    </article>

    <!-- Video Player -->
    <div class="max-w-6xl mx-auto mb-12">
        <div class="brutal-card bg-white p-4 md:p-6">
            <div class="video-embed brutal-card mb-6">
                <iframe 
                    src={embedUrl}
                    title={episode.title}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                ></iframe>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
                <a href={episode.youtube} target="_blank" rel="noopener noreferrer"
                   class="brutal-btn bg-white hover:bg-red-500 hover:text-white flex items-center justify-center gap-2 flex-1">
                    <span class="text-xl">📺</span>
                    Ver en YouTube
                </a>
                <a href={episode.spotify} target="_blank" rel="noopener noreferrer"
                   class="brutal-btn bg-electric text-white hover:bg-black flex items-center justify-center gap-2 flex-1">
                    <span class="text-xl">🎧</span>
                    Escuchar en Spotify
                </a>
            </div>
        </div>
    </div>

    <!-- Episode Navigation -->
    <div class="max-w-6xl mx-auto mb-12">
        <div class="flex justify-between items-center">
            {prev ? (
                <a href={`/episodios/${prev.id}`}
                   class="brutal-btn bg-white hover:bg-acid inline-flex items-center gap-2 text-sm">
                    ← Episodio {prev.data.episode}
                </a>
            ) : (
                <div></div>
            )}
            <a href="/" class="brutal-btn bg-acid hover:bg-electric hover:text-white inline-flex items-center gap-2">
                Volver al Inicio
            </a>
            {next ? (
                <a href={`/episodios/${next.id}`}
                   class="brutal-btn bg-white hover:bg-acid inline-flex items-center gap-2 text-sm">
                    Episodio {next.data.episode} →
                </a>
            ) : (
                <div></div>
            )}
        </div>
    </div>

    <SiteFooter />

    <!-- VideoObject Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "name": episode.title,
        "description": episode.description,
        "thumbnailUrl": ogImage,
        "uploadDate": `${episode.date}T00:00:00-03:00`,
        "duration": `PT${Math.floor(episode.durationSeconds / 60)}M${episode.durationSeconds % 60}S`,
        "contentUrl": episode.youtube,
        "embedUrl": embedUrl,
        "publisher": {
            "@type": "Organization",
            "name": "Es la Hora de Aprender",
            "logo": {
                "@type": "ImageObject",
                "url": "https://eslahoradeaprender.com/og-image.jpg"
            }
        },
        "creator": episode.hosts.map(host => ({
            "@type": "Person",
            "name": host.name,
            "url": host.linkedin
        }))
    })} />

    <!-- PodcastEpisode Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "PodcastEpisode",
        "url": episodeUrl,
        "name": episode.title,
        "description": episode.description,
        "datePublished": `${episode.date}T00:00:00-03:00`,
        "duration": `PT${Math.floor(episode.durationSeconds / 60)}M${episode.durationSeconds % 60}S`,
        "episodeNumber": episode.episode,
        "partOfSeries": {
            "@type": "PodcastSeries",
            "name": "Es la Hora de Aprender",
            "url": "https://eslahoradeaprender.com"
        },
        "actor": episode.hosts.map(host => ({
            "@type": "Person",
            "name": host.name,
            "url": host.linkedin
        }))
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Inicio",
                "item": "https://eslahoradeaprender.com"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Episodios",
                "item": "https://eslahoradeaprender.com/#episodios"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": episode.title,
                "item": episodeUrl
            }
        ]
    })} />
</BaseLayout>
