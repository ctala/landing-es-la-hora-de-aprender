---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const allEpisodes = await getCollection('episodes');
const episodes = allEpisodes.sort((a, b) => b.data.episode - a.data.episode); // newest first
const latest = episodes[0];
const olderEpisodes = episodes.slice(1);
const TOPICS_VISIBLE = 5;
---

<BaseLayout title="Tech Podcast">
    <SiteHeader/>
    <!-- Marquee -->
    <div class="marquee-slim brutal-card z-10 relative mb-8 md:mb-10">
        <div class="marquee-content-slim uppercase tracking-tight">
            TECH & STARTUPS ⚡️ NUEVO EPISODIO CADA SEMANA ⚡️ IA Y AUTOMATIZACIÓN ⚡️ TECH & STARTUPS ⚡️ NUEVO EPISODIO CADA SEMANA ⚡️ IA Y AUTOMATIZACIÓN ⚡️
        </div>
    </div>

    <main id="main-content" class="max-w-6xl mx-auto">
        <!-- Section: Último Episodio (Featured) -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 md:mb-10 gap-4">
            <div>
                <h1 class="text-3xl md:text-5xl tracking-tighter italic">Último <span class="bg-electric text-white px-2 not-italic">Episodio</span></h1>
            </div>
            <div class="brutal-btn bg-acid cursor-default text-[10px] md:text-xs tracking-[0.2em] py-2 px-4">
                EP_{String(latest.data.episode).padStart(2, '0')}_LIVE
            </div>
        </div>

        <!-- Featured Episode Card (Full Size) -->
        <article class="brutal-card p-6 md:p-10 episode-card mb-14 md:mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
                <!-- Video Thumbnail (click to play) -->
                <div class="lg:col-span-7">
                    <div class="video-embed brutal-card youtube-facade" data-id={latest.data.youtubeId}>
                        <img 
                            src={latest.data.thumbnail?.replace('.webp', '-sm.webp') || `https://img.youtube.com/vi/${latest.data.youtubeId}/maxresdefault.jpg`}
                            alt={`Thumbnail del episodio: ${latest.data.title}`}
                            loading="eager"
                            width="648"
                            height="365"
                            style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;cursor:pointer;"
                        />
                        <button class="yt-play-btn" aria-label={`Reproducir ${latest.data.title}`}>
                            <svg width="68" height="48" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Info Section -->
                <div class="lg:col-span-5">
                    <div class="mb-4">
                        <span class="bg-black text-acid px-3 py-1 text-xs uppercase font-black tracking-wider">
                            Episodio {latest.data.episode}
                        </span>
                        <span class="text-sm text-gray-500 ml-3">{latest.data.duration}</span>
                    </div>
                    
                    <h2 class="text-2xl md:text-3xl font-black mb-4 leading-tight tracking-tighter text-black">
                        {latest.data.title}
                    </h2>
                    
                    <p class="text-gray-700 text-base md:text-lg mb-5 leading-relaxed">
                        {latest.data.description}
                    </p>

                    <div class="mb-5 topics-container" data-total={latest.data.topics.length}>
                        <h3 class="text-sm font-black uppercase tracking-wider mb-3 text-gray-500">Temas tratados</h3>
                        <div class="flex flex-wrap gap-2 topics-list">
                            {latest.data.topics.map((topic, i) => (
                                <span class={`bg-acid text-black px-3 py-1 text-xs font-bold uppercase border-2 border-black topic-tag ${i >= TOPICS_VISIBLE ? 'hidden' : ''}`} data-index={i}>
                                    {topic}
                                </span>
                            ))}
                        </div>
                        {latest.data.topics.length > TOPICS_VISIBLE && (
                            <button class="topics-toggle text-xs font-bold uppercase mt-3 text-electric hover:text-black transition-colors">
                                Ver {latest.data.topics.length - TOPICS_VISIBLE} temas más ↓
                            </button>
                        )}
                    </div>

                    <!-- CTAs: principal full-width + secundarios lado a lado -->
                    <div class="flex flex-col gap-3 mb-4">
                        <a href={`/episodios/${latest.id}`}
                           class="brutal-btn bg-acid hover:bg-electric hover:text-white w-full flex items-center justify-center gap-2 text-sm font-black">
                            Ver Episodio Completo →
                        </a>
                        <div class="grid grid-cols-2 gap-3">
                            <a href={latest.data.youtube} target="_blank" rel="noopener noreferrer"
                               class="brutal-btn bg-white hover:bg-red-500 hover:text-white text-xs flex items-center justify-center gap-1.5">
                                <svg width="14" height="10" viewBox="0 0 68 48" fill="currentColor"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path d="M45 24L27 14v20" fill="white"/></svg>
                                YouTube
                            </a>
                            <a href={latest.data.spotify} target="_blank" rel="noopener noreferrer"
                               class="brutal-btn bg-electric text-white hover:bg-black text-xs flex items-center justify-center gap-1.5">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                                Spotify
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <!-- Section: Episodios Anteriores -->
        {olderEpisodes.length > 0 && (
            <>
                <div class="mb-8 md:mb-10">
                    <h2 class="text-2xl md:text-4xl tracking-tighter italic">Episodios <span class="bg-black text-acid px-2 not-italic">Anteriores</span></h2>
                </div>

                <div id="episodes-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                    {olderEpisodes.map((ep) => (
                        <article class="brutal-card episode-card-compact group">
                            <!-- Thumbnail -->
                            <a href={`/episodios/${ep.id}`} class="block">
                                <div class="relative aspect-video overflow-hidden">
                                    <img 
                                        src={ep.data.thumbnail?.replace('.webp', '-xs.webp') || `https://img.youtube.com/vi/${ep.data.youtubeId}/mqdefault.jpg`}
                                        srcset={ep.data.thumbnail ? `${ep.data.thumbnail.replace('.webp', '-xs.webp')} 400w, ${ep.data.thumbnail.replace('.webp', '-sm.webp')} 648w` : undefined}
                                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                        alt={`Thumbnail: ${ep.data.title}`}
                                        width="400"
                                        height="225"
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                    <div class="absolute top-3 left-3">
                                        <span class="bg-black text-acid px-2 py-1 text-[10px] uppercase font-black tracking-wider">
                                            EP {ep.data.episode}
                                        </span>
                                    </div>
                                    <div class="absolute bottom-3 right-3">
                                        <span class="bg-black/80 text-white px-2 py-1 text-[10px] font-bold">
                                            {ep.data.duration}
                                        </span>
                                    </div>
                                </div>
                            </a>
                            
                            <!-- Info -->
                            <div class="p-5">
                                <h3 class="text-lg font-black mb-2 leading-tight tracking-tight text-black line-clamp-2">
                                    <a href={`/episodios/${ep.id}`} class="hover:text-electric transition-colors">
                                        {ep.data.title}
                                    </a>
                                </h3>
                                
                                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                    {ep.data.description}
                                </p>

                                <!-- Topics (compact, max 3) -->
                                <div class="flex flex-wrap gap-1 mb-4">
                                    {ep.data.topics.slice(0, 3).map((topic) => (
                                        <span class="bg-acid/60 text-black px-2 py-0.5 text-[10px] font-bold uppercase border border-black">
                                            {topic}
                                        </span>
                                    ))}
                                    {ep.data.topics.length > 3 && (
                                        <span class="text-[10px] text-gray-500 font-bold self-center">
                                            +{ep.data.topics.length - 3}
                                        </span>
                                    )}
                                </div>

                                <!-- CTA -->
                                <a href={`/episodios/${ep.id}`}
                                   class="brutal-btn bg-white hover:bg-acid w-full text-xs py-2 flex items-center justify-center">
                                    Ver Episodio →
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            </>
        )}
    </main>

    <SiteFooter/>

    <style>
        /* Compact header styles */
        .name-tag-sm {
            background-color: var(--black);
            color: var(--acid-green);
            padding: 2px 8px;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.7rem;
            border: 2px solid var(--black);
        }
        
        .brutal-btn-sm {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 8px 12px;
            border: 2px solid var(--black);
            box-shadow: 3px 3px 0px 0px var(--black);
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.1s;
            text-decoration: none;
            color: var(--black);
        }
        
        .brutal-btn-sm:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0px 0px var(--black);
        }

        /* Marquee */
        .marquee-slim {
            overflow: hidden;
            white-space: nowrap;
            background: var(--electric-blue);
            color: var(--white);
            padding: 6px 0;
            border-bottom: 3px solid var(--black);
            transform: rotate(-0.5deg) scale(1.01);
        }

        .marquee-content-slim {
            display: inline-block;
            animation: marquee 20s linear infinite;
            font-family: 'Archivo Black', sans-serif;
            font-size: 0.75rem;
        }

        @keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* YouTube facade */
        .youtube-facade {
            position: relative;
            cursor: pointer;
        }
        .yt-play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            opacity: 0.9;
            transition: opacity 0.2s;
        }
        .youtube-facade:hover .yt-play-btn {
            opacity: 1;
        }

        /* Compact episode cards */
        .episode-card-compact {
            background: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .episode-card-compact:hover {
            transform: translateY(-4px);
        }

        /* Line clamp for text truncation */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Topics toggle */
        .topic-tag {
            display: inline-block !important;
            width: auto !important;
        }
        .topic-tag.hidden {
            display: none !important;
        }
        .topics-container.expanded .topic-tag.hidden {
            display: inline-block !important;
        }
    </style>

    <script is:inline>
        // YouTube facade click handler
        document.querySelectorAll('.youtube-facade').forEach(el => {
            el.addEventListener('click', function() {
                const id = this.dataset.id;
                const iframe = document.createElement('iframe');
                iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
                iframe.title = 'YouTube video player';
                iframe.frameBorder = '0';
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;';
                this.innerHTML = '';
                this.appendChild(iframe);
            });
        });
        
        // Topics toggle handler
        document.querySelectorAll('.topics-toggle').forEach(btn => {
            btn.addEventListener('click', function() {
                const container = this.closest('.topics-container');
                const isExpanded = container.classList.toggle('expanded');
                const total = parseInt(container.dataset.total);
                const visible = 5;
                
                if (isExpanded) {
                    this.textContent = 'Ver menos ↑';
                } else {
                    this.textContent = `Ver ${total - visible} temas más ↓`;
                }
            });
        });
    </script>
</BaseLayout>
