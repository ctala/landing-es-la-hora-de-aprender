---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';

const allEpisodes = await getCollection('episodes');
const episodes = allEpisodes.sort((a, b) => b.data.episode - a.data.episode); // newest first
const latest = episodes[0];
---

<BaseLayout title="Tech Podcast">
    <!-- Marquee Principal -->
    <div class="marquee brutal-card z-10 relative">
        <div class="marquee-content uppercase tracking-tight">
            ES LA HORA DE APRENDER ⚡️ CRISTIAN TALA ⚡️ DIEGO ARIAS ⚡️ RODRIGO ROJO ⚡️ NUEVO EPISODIO CADA SEMANA ⚡️ TECH
            & STARTUPS ⚡️ ES LA HORA DE APRENDER ⚡️ CRISTIAN TALA ⚡️ DIEGO ARIAS ⚡️ RODRIGO ROJO ⚡️
        </div>
    </div>

    <header id="main-content" class="max-w-6xl mx-auto mb-12 md:mb-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 items-stretch">
            <div class="lg:col-span-8 brutal-card bg-acid p-6 md:p-16">
                <h1
                    class="text-4xl sm:text-6xl md:text-8xl lg:text-9xl leading-[0.9] mb-6 md:mb-8 tracking-tighter break-words">
                    ES LA HORA<br>DE <span class="text-white" style="text-shadow: 4px 4px 0px #000;">APRENDER</span>
                </h1>
                <div class="flex flex-wrap gap-2 md:gap-4 mb-6 md:mb-8">
                    <a href="https://www.linkedin.com/in/ctala/" target="_blank" class="name-tag hover:bg-electric transition-colors">Cristian Tala</a>
                    <a href="https://www.linkedin.com/in/godiegoarias/" target="_blank" class="name-tag hover:bg-electric transition-colors">Diego Arias</a>
                    <a href="https://www.linkedin.com/in/rodrigorojo/" target="_blank" class="name-tag hover:bg-electric transition-colors">Rodrigo Rojo</a>
                </div>
                <p
                    class="text-lg md:text-2xl font-bold max-w-2xl border-l-4 md:border-l-8 border-black pl-4 md:pl-6 mb-8 md:mb-10">
                    Tecnologías, IA y el futuro del ecosistema digital analizado semanalmente por quienes están en la
                    cancha.
                </p>

                <!-- Botones de Suscripción -->
                <div class="flex flex-col sm:flex-row gap-4 md:gap-6">
                    <a href="https://www.youtube.com/@EsLaHoraDeAprender_com?sub_confirmation=1" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Suscribirse al canal de YouTube de Es la Hora de Aprender"
                       class="brutal-btn bg-white hover:bg-red-500 hover:text-white flex items-center justify-center gap-2">
                        <span class="text-xl md:text-2xl" aria-hidden="true">📺</span> Suscribirse en YouTube
                    </a>
                    <a href="https://open.spotify.com/show/7o7JR0Un1jc6wev0VjNm0C" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Escuchar el podcast Es la Hora de Aprender en Spotify"
                       class="brutal-btn bg-electric text-white hover:bg-black flex items-center justify-center gap-2">
                        <span class="text-xl md:text-2xl" aria-hidden="true">🎧</span> Escuchar en Spotify
                    </a>
                </div>
            </div>

            <div class="lg:col-span-4 flex flex-col gap-6">
                <div class="brutal-card bg-electric p-6 md:p-8 flex-grow text-white flex flex-col justify-center">
                    <div class="text-4xl md:text-5xl font-black mb-4 tracking-tighter">ÚNETE</div>
                    <p class="font-bold text-base md:text-lg opacity-90 leading-tight">Suscríbete en YouTube y Spotify para no
                        perderte ningún episodio.</p>
                </div>
                <div class="brutal-card bg-white p-6 md:p-8">
                    <div class="text-4xl md:text-5xl font-black mb-2 tracking-tighter uppercase text-black">Episodio {latest.data.episode}</div>
                    <p class="uppercase font-bold tracking-widest text-xs md:text-sm italic text-electric">
                        {new Date(latest.data.date + 'T12:00:00').toLocaleDateString('es-CL', { month: 'long' })} {new Date(latest.data.date + 'T12:00:00').getFullYear()} • Temporada {latest.data.season}
                    </p>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 md:mb-16 gap-6">
            <div>
                <h2 class="text-4xl md:text-6xl tracking-tighter italic">Últimos <br><span
                        class="bg-electric text-white px-2 not-italic">Episodios</span></h2>
            </div>
            <div class="brutal-btn bg-acid cursor-default text-[10px] md:text-xs tracking-[0.2em] py-2 px-4">
                EP_{String(latest.data.episode).padStart(2, '0')}_LIVE
            </div>
        </div>

        <div id="episodes-container" class="grid gap-8 md:gap-12">
            {episodes.map((ep) => (
                <article class="brutal-card p-6 md:p-10 episode-card">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
                        <!-- Video Thumbnail (click to play) -->
                        <div class="lg:col-span-7">
                            <div class="video-embed brutal-card youtube-facade" data-id={ep.data.youtubeId}>
                                <img 
                                    src={ep.data.thumbnail || `https://img.youtube.com/vi/${ep.data.youtubeId}/maxresdefault.jpg`}
                                    alt={`Thumbnail del episodio: ${ep.data.title}`}
                                    loading="lazy"
                                    width="1280"
                                    height="720"
                                    style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;cursor:pointer;"
                                />
                                <button class="yt-play-btn" aria-label={`Reproducir ${ep.data.title}`}>
                                    <svg width="68" height="48" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>
                                </button>
                            </div>
                        </div>

                        <!-- Info Section -->
                        <div class="lg:col-span-5">
                            <div class="mb-4">
                                <span class="bg-black text-acid px-3 py-1 text-xs uppercase font-black tracking-wider">
                                    Episodio {ep.data.episode}
                                </span>
                                <span class="text-sm text-gray-500 ml-3">{ep.data.duration}</span>
                            </div>
                            
                            <h3 class="text-3xl md:text-4xl font-black mb-4 leading-tight tracking-tighter text-black">
                                {ep.data.title}
                            </h3>
                            
                            <p class="text-gray-700 text-base md:text-lg mb-6 leading-relaxed">
                                {ep.data.description}
                            </p>

                            <div class="mb-6">
                                <h4 class="text-sm font-black uppercase tracking-wider mb-3 text-gray-500">Temas tratados</h4>
                                <div class="flex flex-wrap gap-2">
                                    {ep.data.topics.map((topic) => (
                                        <span class="bg-acid text-black px-3 py-1 text-xs font-bold uppercase border-2 border-black">
                                            {topic}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            <div class="mb-4">
                                <a href={`/episodios/${ep.id}`}
                                   class="brutal-btn bg-acid hover:bg-electric hover:text-white w-full flex items-center justify-center gap-2 text-sm font-black">
                                    Ver Episodio Completo →
                                </a>
                            </div>
                            
                            <div class="flex flex-col sm:flex-row gap-3">
                                <a href={ep.data.youtube} target="_blank" rel="noopener noreferrer"
                                   class="brutal-btn bg-white hover:bg-red-500 hover:text-white text-sm flex-1 flex items-center justify-center gap-2">
                                    <span class="text-xl">📺</span>
                                    Ver en YouTube
                                </a>
                                <a href={ep.data.spotify} target="_blank" rel="noopener noreferrer"
                                   class="brutal-btn bg-electric text-white hover:bg-black text-sm flex-1 flex items-center justify-center gap-2">
                                    <span class="text-xl">🎧</span>
                                    Escuchar en Spotify
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <SiteFooter />

    <style>
        .youtube-facade {
            position: relative;
            cursor: pointer;
        }
        .yt-play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            opacity: 0.9;
            transition: opacity 0.2s;
        }
        .youtube-facade:hover .yt-play-btn {
            opacity: 1;
        }
    </style>

    <script is:inline>
        document.querySelectorAll('.youtube-facade').forEach(el => {
            el.addEventListener('click', function() {
                const id = this.dataset.id;
                const iframe = document.createElement('iframe');
                iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
                iframe.title = 'YouTube video player';
                iframe.frameBorder = '0';
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;';
                this.innerHTML = '';
                this.appendChild(iframe);
            });
        });
    </script>
</BaseLayout>
