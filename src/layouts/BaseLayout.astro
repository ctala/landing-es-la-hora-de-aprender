---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  keywords?: string[];
  canonicalUrl?: string;
  datePublished?: string;
}

const { 
  title, 
  description = "Tecnologías, IA y el futuro del ecosistema digital analizado semanalmente por quienes están en la cancha.",
  image = "https://eslahoradeaprender.com/og-image.jpg",
  ogType = "website",
  keywords = [],
  canonicalUrl,
  datePublished,
} = Astro.props;

const siteUrl = "https://eslahoradeaprender.com";
const fullTitle = title === "Tech Podcast" ? "Es la Hora de Aprender (2026) - Podcast Tech sobre IA y Startups en Chile" : `${title} | Es la Hora de Aprender`;
const pageUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString().replace(/\/$/, '');
const allKeywords = [...new Set([...keywords, "podcast", "tecnología", "IA", "inteligencia artificial", "startups", "Chile"])].join(', ');
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    
    <!-- Canonical & Alternate -->
    <link rel="canonical" href={pageUrl}>
    <link rel="alternate" type="application/rss+xml" title="Es la Hora de Aprender - RSS Feed" href={`${siteUrl}/feed.xml`}>
    
    <!-- hreflang (Multi-language Support) -->
    <link rel="alternate" hreflang="es" href={pageUrl}>
    <link rel="alternate" hreflang="es-cl" href={pageUrl}>
    <link rel="alternate" hreflang="x-default" href={pageUrl}>
    
    <!-- Geo Tags (Local SEO - Chile) -->
    <meta name="geo.region" content="CL-RM">
    <meta name="geo.placename" content="Santiago">
    <meta name="geo.position" content="-33.4489;-70.6693">
    <meta name="ICBM" content="-33.4489, -70.6693">
    
    <!-- PWA & Mobile -->
    <meta name="theme-color" content="#2d5bff">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="EHDA">
    <link rel="manifest" href="/manifest.json">
    
    <!-- Icons (Placeholders - generar con https://realfavicongenerator.net/) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <!-- Preconnect (only critical origins) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Google Fonts — async load (non-render-blocking) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet"></noscript>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={pageUrl}>
    <meta property="og:title" content={fullTitle}>
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="es_CL">
    <meta property="og:site_name" content="Es la Hora de Aprender">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={pageUrl}>
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:creator" content="@naitus">
    
    <!-- Additional Meta -->
    <meta name="author" content="Cristian Tala, Diego Arias, Rodrigo Rojo">
    <meta name="keywords" content={allKeywords}>
    
    <!-- Service Worker Registration (PWA) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('SW registered:', registration);
            })
            .catch((error) => {
              console.log('SW registration failed:', error);
            });
        });
      }
    </script>
    
    <!-- Schema.org JSON-LD for Podcast -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "Es la Hora de Aprender",
      "description": "Tecnologías, IA y el futuro del ecosistema digital analizado semanalmente por quienes están en la cancha.",
      "url": "https://eslahoradeaprender.com",
      "image": "https://eslahoradeaprender.com/og-image.jpg",
      "author": [
        {
          "@type": "Person",
          "name": "Cristian Tala",
          "url": "https://www.linkedin.com/in/ctala/",
          "sameAs": [
            "https://www.linkedin.com/in/ctala/",
            "https://twitter.com/naitus",
            "https://cristiantala.com"
          ]
        },
        {
          "@type": "Person",
          "name": "Diego Arias",
          "url": "https://www.linkedin.com/in/godiegoarias/"
        },
        {
          "@type": "Person",
          "name": "Rodrigo Rojo",
          "url": "https://www.linkedin.com/in/rodrigorojo/"
        }
      ],
      "genre": ["Technology", "Business", "Education"],
      "inLanguage": "es-CL",
      "publisher": {
        "@type": "Organization",
        "name": "Es la Hora de Aprender",
        "logo": {
          "@type": "ImageObject",
          "url": "https://eslahoradeaprender.com/og-image.jpg"
        }
      }
    }
    </script>
</head>
<body class="p-4 md:p-8 hero-pattern">
    <!-- Skip to Content Link (Accessibility) -->
    <a href="#main-content" class="skip-link">
        Saltar al contenido principal
    </a>
    
    <slot />
    
    <style is:global>
        :root {
            --acid-green: #ccff00;
            --electric-blue: #2d5bff;
            --black: #000000;
            --white: #ffffff;
        }

        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: var(--white);
            color: var(--black);
            margin: 0;
            padding: 0 1rem 6rem 1rem;
            overflow-x: hidden;
            min-height: 100vh;
        }
        
        @media (min-width: 768px) {
            body {
                padding: 0 2rem 8rem 2rem;
            }
        }

        h1, h2, h3, .brutal-title {
            font-family: 'Archivo Black', sans-serif;
            text-transform: uppercase;
        }

        .brutal-card {
            background: var(--white);
            border: 4px solid var(--black);
            box-shadow: 6px 6px 0px 0px var(--black);
            transition: all 0.15s ease-in-out;
        }

        @media (min-width: 768px) {
            .brutal-card {
                box-shadow: 10px 10px 0px 0px var(--black);
            }
        }

        .brutal-card:hover {
            transform: translate(-2px, -2px);
            box-shadow: 8px 8px 0px 0px var(--black);
        }

        @media (min-width: 768px) {
            .brutal-card:hover {
                transform: translate(-4px, -4px);
                box-shadow: 14px 14px 0px 0px var(--black);
            }
        }

        .brutal-btn {
            display: inline-block;
            padding: 12px 24px;
            background: var(--acid-green);
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
            font-weight: 800;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.1s;
            text-decoration: none;
            color: var(--black);
            letter-spacing: -0.05em;
            text-align: center;
        }

        @media (min-width: 768px) {
            .brutal-btn {
                padding: 16px 32px;
                border: 4px solid var(--black);
                box-shadow: 6px 6px 0px 0px var(--black);
            }
        }

        .brutal-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 2px 2px 0px 0px var(--black);
        }

        .bg-acid {
            background-color: var(--acid-green);
        }

        .bg-electric {
            background-color: var(--electric-blue);
        }

        .text-electric {
            color: var(--electric-blue);
        }

        .marquee {
            overflow: hidden;
            white-space: nowrap;
            background: var(--electric-blue);
            color: var(--white);
            padding: 10px 0;
            border-bottom: 4px solid var(--black);
            transform: rotate(-1deg) scale(1.02);
            margin-bottom: 30px;
        }

        @media (min-width: 768px) {
            .marquee {
                padding: 15px 0;
                border-bottom: 5px solid var(--black);
                transform: rotate(-1deg) scale(1.05);
                margin-bottom: 40px;
            }
        }

        .marquee-content {
            display: inline-block;
            animation: marquee 25s linear infinite;
            font-family: 'Archivo Black', sans-serif;
            font-size: 1rem;
        }

        @media (min-width: 768px) {
            .marquee-content {
                font-size: 1.5rem;
            }
        }

        @keyframes marquee {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }

        .name-tag {
            background-color: var(--black);
            color: var(--acid-green);
            padding: 4px 10px;
            font-weight: 800;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
            border: 2px solid var(--black);
            font-size: 0.875rem;
        }

        .hero-pattern {
            background-image: radial-gradient(var(--black) 1px, transparent 0);
            background-size: 15px 15px;
            background-color: #f0f0f0;
        }

        .episode-card {
            background: white;
            transition: transform 0.2s;
        }

        .episode-card:hover {
            transform: translateY(-4px);
        }

        .video-embed {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
        }

        .video-embed iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* Skip to Content Link (Accessibility) */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--acid-green);
            color: var(--black);
            padding: 8px 16px;
            text-decoration: none;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 14px;
            z-index: 1000;
            border: 3px solid var(--black);
        }

        .skip-link:focus {
            top: 0;
        }

        /* Custom Focus States (Accessibility) */
        a:focus, 
        button:focus, 
        input:focus, 
        textarea:focus {
            outline: 4px solid var(--acid-green);
            outline-offset: 2px;
        }

        /* Focus visible for keyboard navigation only */
        a:focus:not(:focus-visible),
        button:focus:not(:focus-visible) {
            outline: none;
        }

        a:focus-visible,
        button:focus-visible {
            outline: 4px solid var(--acid-green);
            outline-offset: 2px;
        }
    </style>
</body>
</html>
