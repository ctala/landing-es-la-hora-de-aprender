---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tecnologías, IA y el futuro del ecosistema digital analizado semanalmente por quienes están en la cancha." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Es la hora de aprender</title>
    <meta name="description" content={description}>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
</head>
<body class="p-4 md:p-8 hero-pattern">
    <slot />
    
    <style is:global>
        :root {
            --acid-green: #ccff00;
            --electric-blue: #2d5bff;
            --black: #000000;
            --white: #ffffff;
        }

        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: var(--white);
            color: var(--black);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, .brutal-title {
            font-family: 'Archivo Black', sans-serif;
            text-transform: uppercase;
        }

        .brutal-card {
            background: var(--white);
            border: 4px solid var(--black);
            box-shadow: 6px 6px 0px 0px var(--black);
            transition: all 0.15s ease-in-out;
        }

        @media (min-width: 768px) {
            .brutal-card {
                box-shadow: 10px 10px 0px 0px var(--black);
            }
        }

        .brutal-card:hover {
            transform: translate(-2px, -2px);
            box-shadow: 8px 8px 0px 0px var(--black);
        }

        @media (min-width: 768px) {
            .brutal-card:hover {
                transform: translate(-4px, -4px);
                box-shadow: 14px 14px 0px 0px var(--black);
            }
        }

        .brutal-btn {
            display: inline-block;
            padding: 12px 24px;
            background: var(--acid-green);
            border: 3px solid var(--black);
            box-shadow: 4px 4px 0px 0px var(--black);
            font-weight: 800;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.1s;
            text-decoration: none;
            color: var(--black);
            letter-spacing: -0.05em;
            text-align: center;
        }

        @media (min-width: 768px) {
            .brutal-btn {
                padding: 16px 32px;
                border: 4px solid var(--black);
                box-shadow: 6px 6px 0px 0px var(--black);
            }
        }

        .brutal-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 2px 2px 0px 0px var(--black);
        }

        .bg-acid {
            background-color: var(--acid-green);
        }

        .bg-electric {
            background-color: var(--electric-blue);
        }

        .text-electric {
            color: var(--electric-blue);
        }

        .marquee {
            overflow: hidden;
            white-space: nowrap;
            background: var(--electric-blue);
            color: var(--white);
            padding: 10px 0;
            border-bottom: 4px solid var(--black);
            transform: rotate(-1deg) scale(1.02);
            margin-bottom: 30px;
        }

        @media (min-width: 768px) {
            .marquee {
                padding: 15px 0;
                border-bottom: 5px solid var(--black);
                transform: rotate(-1deg) scale(1.05);
                margin-bottom: 40px;
            }
        }

        .marquee-content {
            display: inline-block;
            animation: marquee 25s linear infinite;
            font-family: 'Archivo Black', sans-serif;
            font-size: 1rem;
        }

        @media (min-width: 768px) {
            .marquee-content {
                font-size: 1.5rem;
            }
        }

        @keyframes marquee {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }

        .name-tag {
            background-color: var(--black);
            color: var(--acid-green);
            padding: 4px 10px;
            font-weight: 800;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
            border: 2px solid var(--black);
            font-size: 0.875rem;
        }

        .hero-pattern {
            background-image: radial-gradient(var(--black) 1px, transparent 0);
            background-size: 15px 15px;
            background-color: #f0f0f0;
        }

        .episode-card {
            background: white;
            transition: transform 0.2s;
        }

        .episode-card:hover {
            transform: translateY(-4px);
        }

        .video-embed {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
        }

        .video-embed iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
    </style>
</body>
</html>
