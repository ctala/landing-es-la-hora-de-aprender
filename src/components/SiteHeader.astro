---
import BaseLayout from '../layouts/BaseLayout.astro';
import Link from '../components/Link.astro';

const { episode, latest } = Astro.props;

export const prerender = false;
---

<header class="max-w-6xl mx-auto mb-4">
    <div class="brutal-card bg-acid p-4 md:p-5">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <!-- Logo + Tagline -->
            <div class="flex items-center gap-4">
                <Link class="text-2xl md:text-3xl font-black tracking-tighter hover:text-electric transition-colors whitespace-nowrap">
                    ES LA HORA DE <span class="text-white" style="text-shadow: 2px 2px 0px #000;">APRENDER</span>
                </Link>
            </div>
            
            <!-- Hosts + CTAs -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="hidden lg:flex gap-2">
                    <Link class="name-tag-sm hover:bg-electric transition-colors" href="https://www.linkedin.com/in/ctala/">Cristian</Link>
                    <Link class="name-tag-sm hover:bg-electric transition-colors" href="https://www.linkedin.com/in/godiegoarias/">Diego</Link>
                    <Link class="name-tag-sm hover:bg-electric transition-colors" href="https://www.linkedin.com/in/rodrigorojo/">Rodrigo</Link>
                </div>
                <div class="flex gap-2">
                    <Link class="brutal-btn-sm bg-white hover:bg-red-500 hover:text-white" href="https://www.youtube.com/@EsLaHoraDeAprender_com?sub_confirmation=1">
                        <span aria-hidden="true">📺</span> <span class="hidden sm:inline">YouTube</span>
                    </Link>
                    <Link class="brutal-btn-sm bg-electric text-white hover:bg-black" href="https://open.spotify.com/show/7o7JR0Un1jc6wev0VjNm0C">
                        <span aria-hidden="true">🎧</span> <span class="hidden sm:inline">Spotify</span>
                    </Link>
                </div>
            </div>
        </div>
    </header>
