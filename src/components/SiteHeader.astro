---
// Simple site header for episode pages
---

<header class="max-w-6xl mx-auto mb-8 md:mb-12">
    <div class="brutal-card bg-white p-4 md:p-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <!-- Logo/Home Link -->
            <a href="/" 
               aria-label="Volver a la página principal de Es la Hora de Aprender"
               class="text-2xl md:text-3xl font-black tracking-tighter hover:text-electric transition-colors">
                ES LA HORA DE <span class="text-electric">APRENDER</span>
            </a>
            
            <!-- CTA Buttons -->
            <div class="flex gap-3 w-full md:w-auto">
                <a href="https://www.youtube.com/@EsLaHoraDeAprender_com?sub_confirmation=1" 
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Suscribirse al canal de YouTube de Es la Hora de Aprender"
                   class="brutal-btn bg-white hover:bg-red-500 hover:text-white text-xs md:text-sm flex-1 md:flex-initial flex items-center justify-center gap-1">
                    <span class="text-base" aria-hidden="true">📺</span> YouTube
                </a>
                <a href="https://open.spotify.com/show/7o7JR0Un1jc6wev0VjNm0C" 
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Escuchar el podcast en Spotify"
                   class="brutal-btn bg-electric text-white hover:bg-black text-xs md:text-sm flex-1 md:flex-initial flex items-center justify-center gap-1">
                    <span class="text-base" aria-hidden="true">🎧</span> Spotify
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    /* Header-specific styles if needed */
</style>
