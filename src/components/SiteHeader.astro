---
// SiteHeader.astro — Header compacto del podcast
---

<header class="max-w-6xl mx-auto mb-4">
    <div class="brutal-card bg-acid p-4 md:p-5">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <!-- Logo -->
            <div class="flex items-center gap-4">
                <a href="/" class="text-2xl md:text-3xl font-black tracking-tighter hover:text-electric transition-colors whitespace-nowrap">
                    ES LA HORA DE <span class="text-white" style="text-shadow: 2px 2px 0px #000;">APRENDER</span>
                </a>
            </div>
            
            <!-- Hosts + CTAs -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="hidden lg:flex gap-2">
                    <a href="https://www.linkedin.com/in/ctala/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Cristian</a>
                    <a href="https://www.linkedin.com/in/godiegoarias/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Diego</a>
                    <a href="https://www.linkedin.com/in/rodrigorojo/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Rodrigo</a>
                </div>
                <div class="flex gap-2">
                    <a href="https://www.youtube.com/@EsLaHoraDeAprender_com?sub_confirmation=1" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Suscribirse en YouTube"
                       class="brutal-btn-sm bg-white hover:bg-red-500 hover:text-white">
                        <span aria-hidden="true">📺</span> <span class="hidden sm:inline">YouTube</span>
                    </a>
                    <a href="https://open.spotify.com/show/7o7JR0Un1jc6wev0VjNm0C" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Escuchar en Spotify"
                       class="brutal-btn-sm bg-electric text-white hover:bg-black">
                        <span aria-hidden="true">🎧</span> <span class="hidden sm:inline">Spotify</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
