---
// SiteHeader.astro — Header compacto del podcast
const pathname = Astro.url.pathname;
const isEpisodesPage = pathname === '/episodios/' || pathname === '/episodios' || pathname.startsWith('/episodios/');
const isGuidesPage = pathname === '/guias/' || pathname === '/guias' || pathname.startsWith('/guias/');
const isGlossaryPage = pathname === '/glosario/' || pathname === '/glosario' || pathname.startsWith('/glosario/');
---

<header class="max-w-6xl mx-auto mb-4">
    <div class="brutal-card bg-acid p-4 md:p-5">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <!-- Logo -->
            <div class="flex items-center gap-4">
                <a href="/" class="text-2xl md:text-3xl font-black tracking-tighter hover:text-electric transition-colors whitespace-nowrap">
                    ES LA HORA DE <span class="text-white" style="text-shadow: 2px 2px 0px #000;">APRENDER</span>
                </a>
            </div>
            
            <!-- Hosts + CTAs -->
            <div class="flex flex-wrap items-center gap-3">
                <div class="hidden lg:flex gap-2">
                    <a href="https://www.linkedin.com/in/ctala/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Cristian</a>
                    <a href="https://www.linkedin.com/in/godiegoarias/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Diego</a>
                    <a href="https://www.linkedin.com/in/rodrigorojo/" target="_blank" rel="noopener noreferrer" class="name-tag-sm hover:bg-electric transition-colors">Rodrigo</a>
                </div>
                <div class="flex gap-2">
                    <a href="/episodios/"
                       class="header-nav-btn"
                       aria-current={isEpisodesPage ? 'page' : undefined}>
                        Episodios
                    </a>
                    <a href="/guias/"
                       class="header-nav-btn"
                       aria-current={isGuidesPage ? 'page' : undefined}>
                        Guías
                    </a>
                    <a href="/glosario/"
                       class="header-nav-btn"
                       aria-current={isGlossaryPage ? 'page' : undefined}>
                        Glosario
                    </a>
                    <a href="https://www.youtube.com/@EsLaHoraDeAprender_com?sub_confirmation=1"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Suscribirse en YouTube"
                       class="header-cta-btn hover:bg-red-500 hover:text-white hover:border-red-500">
                        <svg width="16" height="12" viewBox="0 0 68 48" fill="currentColor" aria-hidden="true"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path d="M45 24L27 14v20" fill="white"/></svg>
                        <span class="hidden sm:inline">YouTube</span>
                    </a>
                    <a href="https://open.spotify.com/show/7o7JR0Un1jc6wev0VjNm0C" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Escuchar en Spotify"
                       class="header-cta-btn bg-electric text-white border-electric hover:bg-black hover:border-black">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                        <span class="hidden sm:inline">Spotify</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .name-tag-sm {
        background-color: var(--black);
        color: var(--acid-green);
        padding: 3px 10px;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.7rem;
        border: 2px solid var(--black);
        text-decoration: none;
        transition: background-color 0.1s;
    }
    .name-tag-sm:hover {
        background-color: var(--electric-blue);
        color: white;
    }

    .header-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border: 2px solid var(--black);
        box-shadow: 2px 2px 0px 0px var(--black);
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.1s;
        text-decoration: none;
        color: var(--black);
        background-color: white;
        letter-spacing: 0.05em;
    }
    .header-cta-btn:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px 0px var(--black);
    }

    .header-nav-btn {
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border: 2px solid var(--black);
        box-shadow: 2px 2px 0px 0px var(--black);
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.1s;
        text-decoration: none;
        background-color: var(--black);
        color: var(--acid-green);
        letter-spacing: 0.05em;
    }
    .header-nav-btn:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px 0px var(--black);
        background-color: var(--electric-blue);
        color: white;
    }
    .header-nav-btn[aria-current="page"] {
        background-color: var(--electric-blue);
        color: white;
    }
</style>
