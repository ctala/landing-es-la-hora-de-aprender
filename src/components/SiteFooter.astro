---
// Ultra-simple footer - Maximum compatibility
---

<footer class="max-w-6xl mx-auto mt-12 md:mt-20 pb-20 md:pb-24">
    <div class="brutal-card bg-black text-white p-6 md:p-10">
        <!-- Title -->
        <h2 class="text-2xl md:text-4xl font-black mb-4 text-acid uppercase">
            ¿Tienes una idea para un episodio?
        </h2>

        <!-- CTA Button -->
        <a href="https://www.linkedin.com/in/ctala/" 
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Contactar a Cristian Tala en LinkedIn para proponer un tema"
           class="brutal-btn bg-acid hover:bg-white text-sm md:text-base inline-block mb-8">
            Proponer Tema
        </a>

        <!-- Hosts -->
        <div class="mb-8">
            <p class="text-xs uppercase tracking-widest font-black text-gray-300 mb-4">
                Hosts:
            </p>
            <div class="space-y-3 text-base md:text-lg">
                <div>
                    <a href="https://www.linkedin.com/in/ctala/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Cristian Tala"
                       class="text-white hover:text-acid transition-colors font-bold block">
                        → Cristian Tala
                    </a>
                </div>
                <div>
                    <a href="https://www.linkedin.com/in/rodrigorojo/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Rodrigo Rojo"
                       class="text-white hover:text-acid transition-colors font-bold block">
                        → Rodrigo Rojo
                    </a>
                </div>
                <div>
                    <a href="https://www.linkedin.com/in/godiegoarias/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Diego Arias"
                       class="text-white hover:text-acid transition-colors font-bold block">
                        → Diego Arias
                    </a>
                </div>
            </div>
        </div>

        <!-- Credits -->
        <div class="border-t border-gray-700 pt-4 text-center">
            <p class="text-xs font-bold text-gray-200 mb-2">
                ES LA HORA DE APRENDER • 2026 • SANTIAGO, CHILE
            </p>
            <p class="text-[10px] text-gray-400">
                v2.2.2 • Feb 18, 2026
            </p>
        </div>
    </div>
</footer>
