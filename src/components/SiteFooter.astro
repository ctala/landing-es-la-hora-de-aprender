            </div>
        </div>

        <!-- Credits -->
        <div class="pt-6 text-center" style="border-top: 2px solid #2d5bff;">
            <p class="text-sm font-bold mb-2" style="color: #e5e7eb;">
                ES LA HORA DE APRENDER • 2026 • SANTIAGO, CHILE
            </p>
            <p class="text-xs" style="color: #6b7280;">
