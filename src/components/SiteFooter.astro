---
// Footer mejorado con sitios web personales (dofollow)
import pkg from '../../package.json';

const buildDate = new Date().toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'America/Santiago',
});
---

<footer class="max-w-6xl mx-auto mt-12 md:mt-20 pb-20 md:pb-24">
    <div class="brutal-card p-8 md:p-12" style="background-color: #000000; color: #ffffff;">
        
        <!-- Hosts Grid -->
        <div class="mb-10">
            <h3 class="text-sm uppercase tracking-widest font-black mb-6" style="color: #9ca3af;">
                Hosts del Podcast:
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- Cristian Tala -->
                <div class="border-2 p-5" style="border-color: #2d5bff; background-color: rgba(45, 91, 255, 0.05);">
                    <h4 class="text-xl font-black mb-3" style="color: #ffffff;">
                        Cristian Tala
                    </h4>
                    <p class="text-sm mb-4 opacity-80">
                        Inversionista y emprendedor (Startup & VC)
                    </p>
                    <div class="space-y-2">
                        <a href="https://cristiantala.com" 
                           target="_blank"
                           aria-label="Sitio web de Cristian Tala"
                           class="text-sm font-bold block transition-colors"
                           style="color: #ccff00;">
                            🌐 cristiantala.com →
                        </a>
                        <a href="https://www.linkedin.com/in/ctala/" 
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn de Cristian Tala"
                           class="text-sm block transition-colors"
                           style="color: #9ca3af;">
                            LinkedIn →
                        </a>
                    </div>
                </div>

                <!-- Diego Arias -->
                <div class="border-2 p-5" style="border-color: #2d5bff; background-color: rgba(45, 91, 255, 0.05);">
                    <h4 class="text-xl font-black mb-3" style="color: #ffffff;">
                        Diego Arias
                    </h4>
                    <p class="text-sm mb-4 opacity-80">
                        Experto en educación y talento digital
                    </p>
                    <div class="space-y-2">
                        <a href="https://godiegoarias.com" 
                           target="_blank"
                           aria-label="Sitio web de Diego Arias"
                           class="text-sm font-bold block transition-colors"
                           style="color: #ccff00;">
                            🌐 godiegoarias.com →
                        </a>
                        <a href="https://www.linkedin.com/in/godiegoarias/" 
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn de Diego Arias"
                           class="text-sm block transition-colors"
                           style="color: #9ca3af;">
                            LinkedIn →
                        </a>
                    </div>
                </div>

                <!-- Rodrigo Rojo -->
                <div class="border-2 p-5" style="border-color: #2d5bff; background-color: rgba(45, 91, 255, 0.05);">
                    <h4 class="text-xl font-black mb-3" style="color: #ffffff;">
                        Rodrigo Rojo
                    </h4>
                    <p class="text-sm mb-4 opacity-80">
                        Estratega en IA y curador de tendencias
                    </p>
                    <div class="space-y-2">
                        <a href="https://www.rojo.me" 
                           target="_blank"
                           aria-label="Sitio web de Rodrigo Rojo"
                           class="text-sm font-bold block transition-colors"
                           style="color: #ccff00;">
                            🌐 rojo.me →
                        </a>
                        <a href="https://www.linkedin.com/in/rodrigorojo/" 
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="LinkedIn de Rodrigo Rojo"
                           class="text-sm block transition-colors"
                           style="color: #9ca3af;">
                            LinkedIn →
                        </a>
                    </div>
                </div>

            </div>
        </div>

        <!-- Credits -->
        <div class="pt-6 text-center" style="border-top: 2px solid #2d5bff;">
            <p class="text-sm font-bold mb-2" style="color: #e5e7eb;">
                ES LA HORA DE APRENDER • 2026 • SANTIAGO, CHILE
            </p>
            <p class="text-xs" style="color: #6b7280;">
                Tech Podcast sobre IA, Startups y Automatización
            </p>
            <p class="text-[10px] mt-2" style="color: #9ca3af;">
                v{pkg.version} • {buildDate}
            </p>
            <p class="text-[10px] mt-1">
                <a href="https://github.com/ctala/landing-es-la-hora-de-aprender/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="hover:underline"
                   style="color: #9ca3af;">
                    Código abierto en GitHub →
                </a>
            </p>
        </div>

    </div>
</footer>
