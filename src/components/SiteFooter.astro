---
// Ultra-simple footer - Inline styles for maximum compatibility
---

<footer class="max-w-6xl mx-auto mt-12 md:mt-20 pb-20 md:pb-24">
    <div class="brutal-card p-6 md:p-10" style="background-color: #000000; color: #ffffff;">
        <!-- Title -->
        <h2 class="text-2xl md:text-4xl font-black mb-4 uppercase" style="color: #ccff00;">
            ¿Tienes una idea para un episodio?
        </h2>

        <!-- CTA Button -->
        <a href="https://www.linkedin.com/in/ctala/" 
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Contactar a Cristian Tala en LinkedIn para proponer un tema"
           class="brutal-btn text-sm md:text-base inline-block mb-8"
           style="background-color: #ccff00; color: #000000;">
            Proponer Tema
        </a>

        <!-- Hosts -->
        <div class="mb-8">
            <p class="text-xs uppercase tracking-widest font-black mb-4" style="color: #d1d5db;">
                Hosts:
            </p>
            <div class="space-y-3 text-base md:text-lg">
                <div>
                    <a href="https://www.linkedin.com/in/ctala/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Cristian Tala"
                       class="hover:text-acid transition-colors font-bold block"
                       style="color: #ffffff;">
                        → Cristian Tala
                    </a>
                </div>
                <div>
                    <a href="https://www.linkedin.com/in/rodrigorojo/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Rodrigo Rojo"
                       class="hover:text-acid transition-colors font-bold block"
                       style="color: #ffffff;">
                        → Rodrigo Rojo
                    </a>
                </div>
                <div>
                    <a href="https://www.linkedin.com/in/godiegoarias/" 
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Perfil de LinkedIn de Diego Arias"
                       class="hover:text-acid transition-colors font-bold block"
                       style="color: #ffffff;">
                        → Diego Arias
                    </a>
                </div>
            </div>
        </div>

        <!-- Credits -->
        <div class="pt-4 text-center" style="border-top: 1px solid #4b5563;">
            <p class="text-xs font-bold mb-2" style="color: #e5e7eb;">
                ES LA HORA DE APRENDER • 2026 • SANTIAGO, CHILE
            </p>
            <p class="text-[10px]" style="color: #9ca3af;">
                v2.2.3 • Feb 18, 2026
            </p>
        </div>
    </div>
</footer>
